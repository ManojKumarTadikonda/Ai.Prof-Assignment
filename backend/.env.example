PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/careflow_ai
JWT_SECRET=change-this-long-secret
APP_URL=http://localhost:5173

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# SendGrid - optional. If absent, emails are logged to console.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Cloudinary - optional. If absent, audio is stored under backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
